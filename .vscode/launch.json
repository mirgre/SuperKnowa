{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Flask",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "/workspaces/SuperKnowa/8. Deploy & Infer/Backend/main.py",
                "FLASK_DEBUG": "1",
                "PYTHONPATH": "/usr/lib64/python39.zip:/usr/lib64/python3.9:/usr/lib64/python3.9/lib-dynload:/opt/app-root/lib64/python3.9/site-packages:/opt/app-root/lib/python3.9/site-packages",
            },
            "args": [
                "run",
                //"--no-debugger",
                //"--no-reload"
                "--port",
                "3001"
            ],
            "jinja": true,
            "autoStartBrowser": false
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "workingDir": "${workspaceFolder}",
            "python": "/opt/app-root/bin/python"
        }
    ]
}